    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="429" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="429" tickCounterLabel="ticks" maxPycor="16" updateMode="1" maxPxcor="16" minPxcor="-16"></view>
    <slider x="15" step="50" y="5" max="5000" width="250" display="num-agents" height="50" min="50" direction="Horizontal" default="1650.0" variable="num-agents"></slider>
    <slider x="15" step="2" y="60" max="30" width="250" display="k-neighbors" height="50" min="2" direction="Horizontal" default="2.0" variable="k-neighbors"></slider>
    <slider x="15" step="0.01" y="115" max="0.5" width="250" display="rewire-prob" height="50" min="0" direction="Horizontal" default="0.1" variable="rewire-prob"></slider>
    <slider x="15" step="0.01" y="170" max="2" width="250" display="epsilon" height="50" min="0" direction="Horizontal" default="0.9" variable="epsilon"></slider>
    <slider x="15" step="0.01" y="225" max="0.5" width="250" display="mu" height="50" min="0" direction="Horizontal" default="0.3" variable="mu"></slider>
    <button x="50" y="280" height="45" disableUntilTicks="false" forever="false" kind="Observer" width="80">setup</button>
    <button x="145" y="280" height="45" disableUntilTicks="false" forever="true" kind="Observer" width="80">go</button>
    <slider x="15" step="0.0005" y="330" max="0.02" width="250" display="shock-prob" height="50" min="0" direction="Horizontal" default="0.0085" variable="shock-prob"></slider>
    <slider x="460" step="1" y="450" max="100000" width="250" display="rng-seed" height="50" min="-1" direction="Horizontal" default="42.0" variable="rng-seed"></slider>
    <slider x="15" step="0.01" y="385" max="0.3" width="250" display="shock-magnitude" height="50" min="0" direction="Horizontal" default="0.13" variable="shock-magnitude"></slider>
    <slider x="15" step="1" y="440" max="500" width="250" display="shock-duration" height="50" min="1" direction="Horizontal" default="10.0" variable="shock-duration"></slider>
    <slider x="15" step="0.01" y="495" max="0.5" width="250" display="bias-strength" height="50" min="-0.5" direction="Horizontal" default="0.0" variable="bias-strength"></slider>
    <monitor x="825" precision="3" y="10" height="60" fontSize="11" width="100" display="Frac A (x&gt;0)">frac-positive</monitor>
    <monitor x="825" precision="3" y="80" height="60" fontSize="11" width="100" display="Frac B (x&lt;0)">1 - (frac-positive)</monitor>
    <monitor x="825" precision="3" y="150" height="60" fontSize="11" width="100" display="Mean x">mean-opinion</monitor>
    <monitor x="825" precision="3" y="220" height="60" fontSize="11" width="100" display="Var x">var-opinion</monitor>
    <monitor x="825" precision="3" y="290" height="60" fontSize="11" width="100" display="Shock Active?"><![CDATA[shock-remaining > 0]]></monitor>
    <plot x="950" autoPlotX="true" yMax="1.0" autoPlotY="true" yAxis="fraction of agents" y="35" xMin="0.0" height="240" legend="false" xMax="10.0" yMin="0.0" width="365" xAxis="time (ticks)" display="Opinion Share">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="Frac A" color="-13345367" legend="true">
        <setup></setup>
        <update>plot frac-positive</update>
      </pen>
      <pen interval="1.0" mode="0" display="Frac B" color="-2674135" legend="true">
        <setup></setup>
        <update>plot (1 - frac-positive)</update>
      </pen>
    </plot>
    <monitor x="825" precision="3" y="360" height="60" fontSize="11" width="100" display="Shock Sign">shock-side</monitor>
  </widgets>
