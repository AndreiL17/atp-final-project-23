<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.0-beta2" snapToGrid="true">
  <code><![CDATA[; ============================================================
;  Opinion Dynamics with Shocks on a Watts–Strogatz Network
;  - Small-world network G(num-agents, k, phi)
;  - Continuous opinions x in [-1, 1]
;  - Bounded confidence epsilon
;  - Responsiveness mu
;  - Systematic bias bias-strength
;  - Media shocks: probability q, magnitude H, duration D
; ============================================================

undirected-link-breed [ connections connection ]  ; social links

turtles-own [
  opinion                      ; x in [-1,1]
]

globals [
  shock-remaining              ; ticks left in current shock
  last-shock-sign
  since-last-shock
  current-field                ; h_t (0 or H while shock active)
]

; =========================
; Setup and network build
; =========================
to setup
  clear-all

  ; reproducibility (optional slider: rng-seed, -1 means "don't set")
  if (is-number? rng-seed) and (rng-seed != -1) [
    random-seed rng-seed
  ]

  ; enforce even k (ring connects k/2 on each side)
  if (k-neighbors mod 2 != 0) [
    set k-neighbors k-neighbors + 1
  ]

  ; create agents
  crt num-agents [
    setxy random-xcor random-ycor                  ; temporary layout
    set opinion (2 * random-float 1 - 1)           ; uniform in [-1,1]
    set shape "circle"
    set size 1.0
    update-agent-color        ; quick visual cue
  ]

  ; build Watts–Strogatz network: start from ring, then rewire with prob phi
  build-ring-lattice
  rewire-small-world

  ; one-time layout for readability (optional)
  layout-spring turtles connections 0.2 10 2

  ; shocks off initially
  set shock-remaining 0
  set current-field 0
  set since-last-shock 50   ;; start “ready” (>= 50)
  set last-shock-sign 0

  reset-ticks
end

to update-agent-color  ;; turtle procedure
  let x opinion
  let gamma 0.5              ;; exaggerate small deviations
  let s round (255 * (abs x) ^ gamma)
  let base 80                ;; controls brightness (lower = more vivid)
  ifelse x >= 0 [
    set color rgb base base (255 - (255 - s) / 2)
  ] [
    set color rgb (255 - (255 - s) / 2) base base
  ]
end

; Create a ring-lattice where each node connects to k/2 neighbors on each side
to build-ring-lattice
  ask connections [ die ]
  let half round (k-neighbors / 2)
  let ordered sort turtles
  let n length ordered

  let i 0
  while [i < n] [
    let a item i ordered
    let offset 1
    while [offset <= half] [
      let j (i + offset) mod n
      let b item j ordered
      if not [link-neighbor? b] of a [
        ask a [ create-connection-with b ]
      ]
      set offset offset + 1
    ]
    set i i + 1
  ]
end



; Randomly rewire each edge with probability phi, keeping degree roughly constant
to rewire-small-world
  ; We'll iterate over a copy to avoid modifying while iterating
  let linklist sort connections
  while [ length linklist > 0 ] [
    let l first linklist
    set linklist but-first linklist

    if (random-float 1 < rewire-prob) [
      let a [end1] of l
      let b [end2] of l

      ifelse (random 2 = 0) [
        ; detach 'a' end, rewire to a non-neighbor (and not itself)
        let target one-of turtles with [ self != a and not [link-neighbor? a] of self ]
        if (target != nobody) [
          ask l [ die ]
          ask a [ create-connection-with target ]
        ]
      ] [
        ; detach 'b' end
        let target one-of turtles with [ self != b and not [link-neighbor? b] of self ]
        if (target != nobody) [
          ask l [ die ]
          ask b [ create-connection-with target ]
        ]
      ]
    ]
  ]
end

; =========================
; Main loop
; =========================
to go
  ; 1) Manage shocks
  update-shock

  ask connections [
    interact end1 end2
  ]

  ask turtles [ update-agent-color ]

  ; 4) Plotting (if pens exist)
  if plot-pen-exists? "Frac A" [
    set-current-plot "Opinion Share"
    set-current-plot-pen "Frac A"
    plot frac-positive
    if plot-pen-exists? "Frac B" [
      set-current-plot-pen "Frac B"
      plot (1 - frac-positive)
    ]
  ]

  tick
end

; =========================
; Interaction and shock rules
; =========================

; Pairwise bounded-confidence + bias + external field, with clipping to [-1,1]
to interact [ i j ]
  let xi [opinion] of i
  let xj [opinion] of j
  let noise-sd 0.01

  ; NEW: shock felt per agent
  let shock-i shock-kick xi
  let shock-j shock-kick xj

  if abs (xi - xj) <= epsilon [
    let n1 (ifelse-value (noise-sd > 0) [ random-normal 0 noise-sd ] [ 0 ])
    let n2 (ifelse-value (noise-sd > 0) [ random-normal 0 noise-sd ] [ 0 ])

    let xi-new xi + mu * ((1 + bias-strength) * xj - xi) + shock-i + n1
    let xj-new xj + mu * ((1 - bias-strength) * xi - xj) + shock-j + n2

    set xi-new clip-to-11 xi-new
    set xj-new clip-to-11 xj-new

    ask i [ set opinion xi-new ]
    ask j [ set opinion xj-new ]
  ]
end



; Shock process: start with prob q, last D ticks, magnitude H (toward +1)
to update-shock
  ;; If a shock is active, count it down
  if (shock-remaining > 0) [
    set shock-remaining shock-remaining - 1
    if (shock-remaining = 0) [
      set current-field 0
      set since-last-shock 0
    ]
  ]

  ;; If no shock is active, advance cooldown and maybe start a new one
  if (shock-remaining = 0) [
    set since-last-shock since-last-shock + 1
    if (since-last-shock >= 50) [
      if (random-float 1 < shock-prob) [
        ;; Alternate direction deterministically:
        set current-field (shock-magnitude * one-of [-1 1])
        set last-shock-sign ifelse-value (current-field > 0) [ 1 ] [ ifelse-value (current-field < 0) [ -1 ] [ 0 ] ]
        set shock-remaining shock-duration
        set since-last-shock 0
      ]
    ]
  ]
end

to-report shock-kick [ x ]
  let H abs current-field
  if H = 0 [ report 0 ]
  let shock-threshold 0.06
  let shock-susceptibility 2

  let sgn (ifelse-value (current-field > 0) [ 1 ] [ -1 ])
  let align sgn * x                       ; >0 same side, <0 opposite
  let Hstar shock-threshold
  let beta shock-susceptibility

  if align >= 0 [
    report sgn * H                        ; full effect for aligned agents
  ]

  ; opposite side: only strong shocks, and moderates sway more than extremists
  if H <= Hstar [ report 0 ]
  let intensity ((H - Hstar) / (1 - Hstar))        ; 0..1 as H grows
  let susceptibility ((1 - min list 0.999 (abs x)) ^ beta)
  report sgn * H * intensity * susceptibility
end

to-report shock-side
  if current-field = 0 [ report "none" ]
  if current-field > 0 [ report "blue (+1)" ]
  report "red (-1)"
end

; Clip helper: keep value in [-1,1]
to-report clip-to-11 [ x ]
  if x > 1 [ report 1 ]
  if x < -1 [ report -1 ]
  report x
end

; =========================
; Reporters for monitors
; =========================
to-report frac-positive
  if count turtles = 0 [ report 0 ]
  report count turtles with [ opinion > 0 ] / count turtles
end

to-report mean-opinion
  if count turtles = 0 [ report 0 ]
  report mean [ opinion ] of turtles
end

to-report var-opinion
  if count turtles = 0 [ report 0 ]
  report variance [ opinion ] of turtles
end
]]></code>
